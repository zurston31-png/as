//@version=5
indicator("Memecoin Signal Bot (Volume Spike + RSI + EMA Cross + Breakout)", overlay=true)

// =============================================================================
// This script generates buy/sell signals combining:
//   - Volume spike detection (volume vs its own SMA)
//   - RSI(14) oversold/overbought filter
//   - EMA(9/21) crossover
//   - Price momentum breakout above an N-period high
//
// On a signal it calls alert() with a JSON payload matching
// app/schemas.py::TradingViewAlert on the bot server. To wire it up:
//   1. Add this script to each chart in your watchlist.
//   2. Fill in `Webhook Secret` (must match WEBHOOK_SECRET in the bot's .env)
//      and `Token/Contract Address` (the on-chain mint/contract for that
//      chart's symbol — required for the rug-check filter and DEX execution).
//   3. Right-click the chart -> Add Alert -> Condition: this indicator ->
//      "Any alert() function call" -> Webhook URL: https://<your-domain>/webhook/tradingview
//      -> Create. The message body is generated by the script itself, so the
//      alert dialog's Message box is ignored.
//   4. Repeat per symbol in your watchlist (one alert per chart/symbol).
//
// Payload notes (these are why alerts used to come back 422):
//   - `time` is sent QUOTED. Pine emits unix milliseconds; sending it as a
//     bare number requires a server that coerces int -> str, which older
//     builds did not, so every alert was rejected before the handler ran.
//     A quoted timestamp is accepted by every build.
//   - Any indicator that is still `na` (warmup bars, a symbol with no volume)
//     is sent as JSON `null`, never as `NaN`. `NaN` is not valid JSON and
//     makes the whole body unparseable, which loses the alert entirely.
//   - Prices are formatted with fixed decimals rather than the chart's tick
//     size, so a sub-cent memecoin price is not rounded away to 0.
// =============================================================================

// ---------------- Inputs ----------------
rsiLength         = input.int(14, "RSI Length", group="RSI")
rsiOversold       = input.int(30, "RSI Oversold Level", group="RSI")
rsiOverbought     = input.int(70, "RSI Overbought Level", group="RSI")

emaFastLen        = input.int(9,  "EMA Fast Length", group="EMA")
emaSlowLen        = input.int(21, "EMA Slow Length", group="EMA")

volLookback       = input.int(20, "Volume SMA Lookback", group="Volume")
volSpikeMult      = input.float(2.0, "Volume Spike Multiplier", step=0.1, group="Volume")

breakoutLookback  = input.int(20, "Breakout Lookback (N-period high)", group="Momentum")
useMomentumFilter = input.bool(true, "Require close above breakout high to confirm buy", group="Momentum")

webhookSecret = input.string("changeme-generate-a-long-random-string", "Webhook Secret", group="Bot Webhook")
tokenAddress  = input.string("", "Token/Contract Address (on-chain)", group="Bot Webhook")
chainName     = input.string("solana", "Chain (solana | ethereum | bsc | base | ...)", group="Bot Webhook")
showSetupWarning = input.bool(true, "Warn on chart if the webhook is not configured", group="Bot Webhook")

// ---------------- Indicators ----------------
rsiValue = ta.rsi(close, rsiLength)

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

emaBullCross = ta.crossover(emaFast, emaSlow)
emaBearCross = ta.crossunder(emaFast, emaSlow)

volSma = ta.sma(volume, volLookback)
volumeSpike = volume > volSma * volSpikeMult

breakoutHigh  = ta.highest(high, breakoutLookback)[1]
priceBreakout = close > breakoutHigh

notOverbought = rsiValue < rsiOverbought
notOversold   = rsiValue > rsiOversold

// Buy: bullish EMA cross + volume spike + not already overbought,
// optionally confirmed by a breakout above the recent N-period high.
buyCondition = emaBullCross and volumeSpike and notOverbought and (not useMomentumFilter or priceBreakout)

// Sell: bearish EMA cross, OR RSI turns overbought, OR RSI drops through
// oversold while price is already below the slow EMA (momentum breakdown).
sellCondition = emaBearCross or rsiValue > rsiOverbought or (rsiValue < rsiOversold and close < emaSlow)

// ---------------- Plots ----------------
plot(emaFast, "EMA Fast", color=color.new(color.aqua, 0))
plot(emaSlow, "EMA Slow", color=color.new(color.orange, 0))
plotshape(buyCondition, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sellCondition, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// ---------------- JSON helpers ----------------
// A float that is `na` must become the JSON literal `null`. str.tostring()
// renders it "NaN", which is not valid JSON - one warmup bar would make the
// server unable to parse the body at all, so the alert is simply lost.
jsonNum(value, fmt) =>
    na(value) ? "null" : str.tostring(value, fmt)

// The secret and the contract address are free-text inputs. A stray quote or
// backslash in either would terminate the JSON string early and corrupt the
// payload, so escape both. Order matters: backslashes first, or the escapes
// added for quotes get escaped a second time.
jsonStr(value) =>
    str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\"")

PRICE_FMT = "#.############"
IND_FMT   = "#.####"

// ---------------- Webhook payload ----------------
buildPayload(signalType) =>
    '{"secret":"' + jsonStr(webhookSecret) +
     '","symbol":"' + jsonStr(syminfo.ticker) +
     '","token_address":"' + jsonStr(tokenAddress) +
     '","chain":"' + jsonStr(chainName) +
     '","signal":"' + signalType +
     '","price":' + jsonNum(close, PRICE_FMT) +
     ',"time":"' + str.tostring(time) +
     '","rsi":' + jsonNum(rsiValue, IND_FMT) +
     ',"ema9":' + jsonNum(emaFast, PRICE_FMT) +
     ',"ema21":' + jsonNum(emaSlow, PRICE_FMT) +
     ',"volume":' + jsonNum(volume, IND_FMT) +
     ',"volume_sma":' + jsonNum(volSma, IND_FMT) +
     ',"breakout_level":' + jsonNum(breakoutHigh, PRICE_FMT) +
     '}'

if buyCondition
    alert(buildPayload("buy"), alert.freq_once_per_bar_close)

if sellCondition
    alert(buildPayload("sell"), alert.freq_once_per_bar_close)

// ---------------- Setup warning ----------------
// An unconfigured secret is refused 401 and a blank contract address is
// refused by the rug-check filter. Both fail silently from the chart's side,
// so say it on the chart rather than letting alerts vanish into the server log.
secretMissing = webhookSecret == "" or webhookSecret == "changeme-generate-a-long-random-string"
addressMissing = tokenAddress == ""

if barstate.islast and showSetupWarning and (secretMissing or addressMissing)
    warnText = "Memecoin Signal Bot is not configured:" +
       (secretMissing  ? "\n- set Webhook Secret to match WEBHOOK_SECRET in .env" : "") +
       (addressMissing ? "\n- set Token/Contract Address for this symbol" : "")
    var label warnLabel = na
    label.delete(warnLabel)
    warnLabel := label.new(bar_index, high, warnText, style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.small)
