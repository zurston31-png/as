# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit your real .env file. It contains private keys and API
# secrets. .gitignore already excludes it.

# =============================================================================
# CORE / SAFETY
# =============================================================================

APP_ENV=development

# SAFETY SWITCH. Leave this as "false" until you have paper-traded for at
# least 1-2 weeks and reviewed every simulated trade in the dashboard/DB.
# When false, the bot NEVER submits a real on-chain transaction or exchange
# order, no matter what EXECUTION_BACKEND is set to.
LIVE_TRADING=false

# SECOND safety switch, required in addition to LIVE_TRADING=true for
# EXECUTION_BACKEND=jupiter or evm_1inch specifically. Both backends sign
# and submit real on-chain transactions using code that has been unit-tested
# against mocked responses but never exercised against a funded wallet or
# mainnet from this project's own test suite - that can't be done without
# moving real money. Read app/execution/jupiter.py and/or app/execution/evm.py
# yourself before setting this to true, and start with a small trade size.
# Not required for EXECUTION_BACKEND=cex (ccxt is a mature, widely-used
# library, not code written for this project).
LIVE_EXECUTION_ACKNOWLEDGED=false

HOST=0.0.0.0
PORT=8000

# sqlite (default, zero setup) or postgres, e.g.:
#   postgresql+psycopg2://bot:password@localhost:5432/memecoin_bot
DATABASE_URL=sqlite:///./data/memecoin_bot.db

LOG_LEVEL=INFO

# =============================================================================
# WEBHOOK (TradingView -> bot)
# =============================================================================

# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The bot refuses every alert until this is changed from the placeholder.
WEBHOOK_SECRET=changeme-generate-a-long-random-string
WEBHOOK_PATH=/webhook/tradingview

# Informational only — the real watchlist lives in the TradingView alerts you
# create from pine/memecoin_signal_strategy.pine. Used for documentation /
# the dashboard header.
SYMBOLS_WATCHLIST=WIF,BONK,POPCAT,PEPE,DOGE

# =============================================================================
# CHAIN / EXECUTION
# =============================================================================

# solana | evm
CHAIN=solana

# jupiter (Solana DEX aggregator - quotes only; LIVE submission is disabled,
#          see README "Execution backends") | cex (Binance/Coinbase/Kraken via
# ccxt) | evm_1inch (experimental) | paper (force paper fills regardless of
# LIVE_TRADING)
EXECUTION_BACKEND=jupiter

# Quote currency mint for Jupiter swaps. Default = USDC on Solana mainnet.
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58-encoded private key. ONLY required when LIVE_TRADING=true and
# EXECUTION_BACKEND=jupiter. Fund this wallet with ONLY the capital you are
# willing to lose entirely — memecoins are extremely high risk.
SOLANA_PRIVATE_KEY=

JUPITER_API_BASE=https://quote-api.jup.ag/v6
JUPITER_PRICE_API_BASE=https://price.jup.ag/v6

# --- EVM (experimental, see README "EVM support status") ---
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_CHAIN_ID=1
ONEINCH_API_KEY=
ONEINCH_API_BASE=https://api.1inch.dev/swap/v6.0

# An ERC20 stablecoin address on your target chain (e.g. USDC) - required
# for live EVM execution. Trades are sized in USD and get swapped against
# this token; paying in the chain's native currency (raw ETH/BNB/etc) is
# not supported. VERIFY the contract address yourself from the token's own
# official source (e.g. https://www.circle.com/en/usdc/multichain for USDC)
# before using it here - do not copy an address from an unverified source,
# and this file is not one either.
EVM_QUOTE_TOKEN_ADDRESS=

# --- CEX (ccxt) ---
CEX_EXCHANGE=binance
CEX_API_KEY=
CEX_API_SECRET=

SLIPPAGE_BPS=150
MAX_GAS_PRICE_GWEI=50
MAX_TRADE_SIZE_USD=200

# =============================================================================
# RISK MANAGEMENT — hard limits, enforced on every trade
# (absolute ceilings on these are additionally clamped in code; see
#  app/risk/manager.py HARD_* constants)
# =============================================================================

# Fraction of the portfolio you're willing to LOSE on a single trade if its
# stop-loss is hit. This is risk-based sizing, not a flat position size: the
# bot solves for the notional that makes (notional * STOP_LOSS_PCT) equal
# this fraction of the portfolio, so a wider stop automatically produces a
# smaller position and a tighter stop a larger one — the dollar risk per
# trade stays constant no matter where the stop sits. Because it's computed
# off the CURRENT portfolio value on every trade, a losing streak shrinks
# the next position size by construction; it can never grow to chase a loss.
MAX_PORTFOLIO_PCT_PER_TRADE=0.02
DAILY_LOSS_LIMIT_PCT=0.05
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.30
MAX_CONCURRENT_POSITIONS=5

# Cap on notional exposure to a single token / to the whole portfolio at
# once, as a fraction of portfolio value. Position sizing is clipped to
# whatever room remains under these before a trade is placed — a signal can
# still fire and pass every other check but be sized to $0 (and rejected)
# if the cap is already used up.
MAX_EXPOSURE_PER_TOKEN_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.60

# Automatic circuit breakers, independent of the daily loss limit above. A
# losing streak can stay under the dollar loss limit while still being a
# clear sign the strategy or market has stopped working for now.
MAX_CONSECUTIVE_LOSSES=4
MAX_DAILY_TRADES=8

# Minimum time (seconds) between trades on the same symbol, to stop the bot
# re-entering immediately after being stopped out or closing a winner.
TRADE_COOLDOWN_SECONDS=900

# =============================================================================
# SMART EXITS — layered on top of the fixed stop-loss/take-profit above
# (app/exits/manager.py). Every rule here only ever tightens the stop or
# takes profit; the original stop-loss/take-profit still fire even if every
# rule below is disabled.
# =============================================================================

# Once price is up TRAILING_STOP_ACTIVATION_PCT from entry, the stop starts
# trailing TRAILING_STOP_DISTANCE_PCT behind the peak price and ratchets up
# with it — it never loosens, even on a pullback.
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATION_PCT=0.15
TRAILING_STOP_DISTANCE_PCT=0.10

# Once price is up BREAK_EVEN_TRIGGER_PCT from entry, the stop moves up to
# entry + BREAK_EVEN_BUFFER_PCT so the trade can no longer turn into a loser
# from here, even if everything reverses.
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_PCT=0.10
BREAK_EVEN_BUFFER_PCT=0.01

# Once, at PARTIAL_TAKE_PROFIT_TRIGGER_PCT gain, sell
# PARTIAL_TAKE_PROFIT_SIZE_PCT of the position and let the rest run under
# the remaining exit rules.
PARTIAL_TAKE_PROFIT_ENABLED=true
PARTIAL_TAKE_PROFIT_TRIGGER_PCT=0.20
PARTIAL_TAKE_PROFIT_SIZE_PCT=0.50

# Exit if price falls MOMENTUM_EXIT_DROP_PCT off its peak within the last
# MOMENTUM_EXIT_LOOKBACK_SAMPLES monitor ticks — catches a sharp reversal
# faster than the trailing stop's configured distance would.
MOMENTUM_EXIT_ENABLED=true
MOMENTUM_EXIT_LOOKBACK_SAMPLES=6
MOMENTUM_EXIT_DROP_PCT=0.12

# Exit on two consecutive lower highs after the position's peak, once at
# least TREND_REVERSAL_MIN_SAMPLES price samples have been observed.
TREND_REVERSAL_EXIT_ENABLED=true
TREND_REVERSAL_MIN_SAMPLES=5

# Off by default — most memecoin setups either work quickly or should be cut
# by the other rules above; a stale winner isn't automatically a bad trade.
# Turn on to force an exit after MAX_POSITION_AGE_HOURS regardless of price.
TIME_BASED_EXIT_ENABLED=false
MAX_POSITION_AGE_HOURS=48

# Reference portfolio size in USD. In paper mode this is your simulated
# starting cash. In live mode this should match the USD value of the capital
# you actually funded the trading wallet/exchange account with — the bot
# tracks P&L against this figure via an internal ledger, it does not poll
# your wallet/exchange for a live balance.
PORTFOLIO_STARTING_BALANCE_USD=1000

# =============================================================================
# LIVE SIGNAL SCORE — the 0-100 composite score (app/signals/scoring.py)
# wired into live entry decisions via live OHLCV from GeckoTerminal
# (app/data/live_provider.py). Fail-closed: no trustworthy live candle data
# means the trade is REJECTED, not admitted on a default score.
# =============================================================================

# Master switch. false skips this gate entirely (loud warning logged) -
# entries then run on the TradingView alert + rug check alone, same as
# before this existed.
LIVE_SIGNAL_SCORE_ENABLED=true
MIN_SIGNAL_SCORE_TO_ENTER=75
SIGNAL_SCORE_TIMEFRAME=15m
SIGNAL_SCORE_CANDLE_LIMIT=300
SIGNAL_SCORE_MIN_CANDLES=60
GECKOTERMINAL_API_BASE=https://api.geckoterminal.com/api/v2

# =============================================================================
# RUG-PULL / SCAM FILTER — runs before every buy, blocks the trade on failure
# =============================================================================

RUGCHECK_ENABLED=true
MAX_TOP10_HOLDER_PCT=0.35
MIN_LIQUIDITY_USD=15000
MAX_PRICE_IMPACT_PCT=0.05
DEV_WALLET_SELL_ALERT_PCT=0.10

# Composite Rug Risk Score (0-100, app/rugcheck/risk_score.py) threshold —
# an ADDITIONAL gate on top of the binary checks above, not a replacement.
# A token can fail this even after passing every one of them, if enough
# moderate risk factors (thin liquidity, a brand-new pool, heavy sell
# pressure, a large dev wallet, ...) stack up together.
REJECT_RUG_SCORE_ABOVE=65

# Optional but recommended — higher rate limits than the anonymous tier.
GOPLUS_API_KEY=
GOPLUS_API_BASE=https://api.gopluslabs.io/api/v1
HONEYPOT_API_BASE=https://api.honeypot.is/v2

# =============================================================================
# MONITORING LOOP
# =============================================================================

PRICE_POLL_INTERVAL_SECONDS=30
DEV_WALLET_POLL_INTERVAL_SECONDS=300
DAILY_SUMMARY_HOUR_UTC=23

# =============================================================================
# NOTIFICATIONS
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# DASHBOARD (HTTP Basic Auth)
# =============================================================================

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
