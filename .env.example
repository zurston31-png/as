# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit your real .env file. It contains private keys and API
# secrets. .gitignore already excludes it.

# =============================================================================
# CORE / SAFETY
# =============================================================================

APP_ENV=development

# SAFETY SWITCH. Leave this as "false" until you have paper-traded for at
# least 1-2 weeks and reviewed every simulated trade in the dashboard/DB.
# When false, the bot NEVER submits a real on-chain transaction or exchange
# order, no matter what EXECUTION_BACKEND is set to.
LIVE_TRADING=false

# SECOND safety switch, required in addition to LIVE_TRADING=true for
# EXECUTION_BACKEND=jupiter or evm_1inch specifically. Both backends sign
# and submit real on-chain transactions using code that has been unit-tested
# against mocked responses but never exercised against a funded wallet or
# mainnet from this project's own test suite - that can't be done without
# moving real money. Read app/execution/jupiter.py and/or app/execution/evm.py
# yourself before setting this to true, and start with a small trade size.
# Not required for EXECUTION_BACKEND=cex (ccxt is a mature, widely-used
# library, not code written for this project).
LIVE_EXECUTION_ACKNOWLEDGED=false

HOST=0.0.0.0
PORT=8000

# sqlite (default, zero setup) or postgres, e.g.:
#   postgresql+psycopg2://bot:password@localhost:5432/memecoin_bot
DATABASE_URL=sqlite:///./data/memecoin_bot.db

# --- Database snapshots ---
# The research dataset is the only thing in this project that cannot be
# rebuilt: the code is in git, a month of observed forward returns is not.
#
# BACKUP_DIR IS THE SETTING THAT MATTERS. A backup written next to the database
# is wiped along with it on any host that replaces the filesystem on deploy
# (Railway, Render, Fly, a plain Heroku dyno). Point it at a mounted volume.
# The app warns at startup when it looks like it is on the same disk.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=24
BACKUP_RESTORE_ON_EMPTY=true

LOG_LEVEL=INFO

# =============================================================================
# WEBHOOK (TradingView -> bot)
# =============================================================================

# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The bot refuses every alert until this is changed from the placeholder.
WEBHOOK_SECRET=changeme-generate-a-long-random-string
WEBHOOK_PATH=/webhook/tradingview

# Informational only — the real watchlist lives in the TradingView alerts you
# create from pine/memecoin_signal_strategy.pine. Used for documentation /
# the dashboard header.
SYMBOLS_WATCHLIST=WIF,BONK,POPCAT,PEPE,DOGE

# =============================================================================
# CHAIN / EXECUTION
# =============================================================================

# solana | evm
CHAIN=solana

# jupiter (Solana DEX aggregator - quotes only; LIVE submission is disabled,
#          see README "Execution backends") | cex (Binance/Coinbase/Kraken via
# ccxt) | evm_1inch (experimental) | paper (force paper fills regardless of
# LIVE_TRADING)
EXECUTION_BACKEND=jupiter

# Quote currency mint for Jupiter swaps. Default = USDC on Solana mainnet.
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58-encoded private key. ONLY required when LIVE_TRADING=true and
# EXECUTION_BACKEND=jupiter. Fund this wallet with ONLY the capital you are
# willing to lose entirely — memecoins are extremely high risk.
SOLANA_PRIVATE_KEY=

JUPITER_API_BASE=https://quote-api.jup.ag/v6
JUPITER_PRICE_API_BASE=https://price.jup.ag/v6

# --- EVM (experimental, see README "EVM support status") ---
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_CHAIN_ID=1
ONEINCH_API_KEY=
ONEINCH_API_BASE=https://api.1inch.dev/swap/v6.0

# An ERC20 stablecoin address on your target chain (e.g. USDC) - required
# for live EVM execution. Trades are sized in USD and get swapped against
# this token; paying in the chain's native currency (raw ETH/BNB/etc) is
# not supported. VERIFY the contract address yourself from the token's own
# official source (e.g. https://www.circle.com/en/usdc/multichain for USDC)
# before using it here - do not copy an address from an unverified source,
# and this file is not one either.
EVM_QUOTE_TOKEN_ADDRESS=

# --- CEX (ccxt) ---
CEX_EXCHANGE=binance
CEX_API_KEY=
CEX_API_SECRET=

# Trading fee charged per side in PAPER mode. Matches the backtester's
# default (BacktestConfig.fee_pct) so paper and backtest results are
# comparable — a paper engine charging no fee would look better than the
# backtest meant to validate it, which is the wrong way for an error to lean.
PAPER_FEE_PCT=0.0025

# --- Realistic paper fill model (app/execution/fill_model.py) ---
# Price impact is DERIVED from pool liquidity via constant-product AMM
# math, not configured: a $20 trade and a $20,000 trade against the same
# thin pool cost very different amounts, and charging them identically is
# the main way a memecoin paper simulator flatters itself. These cover the
# rest of what a fill costs.
#
# Every value here changes simulated P&L directly, so all four are part of
# the strategy version hash — changing one starts a new results series
# rather than quietly contaminating the old one.
PAPER_SPREAD_PCT=0.0015
# Confirmation window: a swap is not instant, and on a volatile token the
# price drift during it can dwarf the spread. Solana lands in ~0.4-2s;
# widen these for a slower chain.
PAPER_MIN_CONFIRM_SECONDS=0.4
PAPER_MAX_CONFIRM_SECONDS=2.5
# When true a fill can REVERT if impact + drift exceed SLIPPAGE_BPS, exactly
# as an on-chain swap with slippage protection does — itself a real cost a
# simulator should charge. Set false for the always-fills baseline, which
# is optimistic on purpose and should only be used for comparison.
PAPER_ALLOW_FAILED_FILLS=true

SLIPPAGE_BPS=150
MAX_GAS_PRICE_GWEI=50
MAX_TRADE_SIZE_USD=200

# =============================================================================
# RISK MANAGEMENT — hard limits, enforced on every trade
# (absolute ceilings on these are additionally clamped in code; see
#  app/risk/manager.py HARD_* constants)
# =============================================================================

# Fraction of the portfolio you're willing to LOSE on a single trade if its
# stop-loss is hit. This is risk-based sizing, not a flat position size: the
# bot solves for the notional that makes (notional * STOP_LOSS_PCT) equal
# this fraction of the portfolio, so a wider stop automatically produces a
# smaller position and a tighter stop a larger one — the dollar risk per
# trade stays constant no matter where the stop sits. Because it's computed
# off the CURRENT portfolio value on every trade, a losing streak shrinks
# the next position size by construction; it can never grow to chase a loss.
MAX_PORTFOLIO_PCT_PER_TRADE=0.02
DAILY_LOSS_LIMIT_PCT=0.05
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.30
MAX_CONCURRENT_POSITIONS=5

# Cap on notional exposure to a single token / to the whole portfolio at
# once, as a fraction of portfolio value. Position sizing is clipped to
# whatever room remains under these before a trade is placed — a signal can
# still fire and pass every other check but be sized to $0 (and rejected)
# if the cap is already used up.
MAX_EXPOSURE_PER_TOKEN_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.60

# --- Correlation risk ---
# Five memecoins are not five independent positions. The caps above are both
# satisfied by a book that is really one bet at five times the intended size.
# Only MEASURED correlation (>=0.70, with enough overlapping observations)
# counts toward a cluster - an unmeasured pair is reported but never blocks,
# because on a fresh install every pair is unmeasured.
CORRELATION_RISK_ENABLED=true
MAX_CORRELATED_CLUSTER_PCT=0.30

# --- Data cross-check ---
# Two providers reporting different liquidity for the same token means one is
# wrong and there is no way to tell which. Sizing off the wrong one costs the
# position, so the trade is skipped. Where a value is still needed, the more
# conservative one is used - never an average.
CROSS_CHECK_ENABLED=true
CROSS_CHECK_REQUIRE_TWO_SOURCES=false
CROSS_CHECK_LIQUIDITY_TOLERANCE=0.30

# Automatic circuit breakers, independent of the daily loss limit above. A
# losing streak can stay under the dollar loss limit while still being a
# clear sign the strategy or market has stopped working for now.
MAX_CONSECUTIVE_LOSSES=4
MAX_DAILY_TRADES=8

# Minimum time (seconds) between trades on the same symbol, to stop the bot
# re-entering immediately after being stopped out or closing a winner.
TRADE_COOLDOWN_SECONDS=900

# =============================================================================
# SMART EXITS — layered on top of the fixed stop-loss/take-profit above
# (app/exits/manager.py). Every rule here only ever tightens the stop or
# takes profit; the original stop-loss/take-profit still fire even if every
# rule below is disabled.
# =============================================================================

# Once price is up TRAILING_STOP_ACTIVATION_PCT from entry, the stop starts
# trailing TRAILING_STOP_DISTANCE_PCT behind the peak price and ratchets up
# with it — it never loosens, even on a pullback.
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATION_PCT=0.15
TRAILING_STOP_DISTANCE_PCT=0.10

# Once price is up BREAK_EVEN_TRIGGER_PCT from entry, the stop moves up to
# entry + BREAK_EVEN_BUFFER_PCT so the trade can no longer turn into a loser
# from here, even if everything reverses.
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_PCT=0.10
BREAK_EVEN_BUFFER_PCT=0.01

# Once, at PARTIAL_TAKE_PROFIT_TRIGGER_PCT gain, sell
# PARTIAL_TAKE_PROFIT_SIZE_PCT of the position and let the rest run under
# the remaining exit rules.
PARTIAL_TAKE_PROFIT_ENABLED=true
PARTIAL_TAKE_PROFIT_TRIGGER_PCT=0.20
PARTIAL_TAKE_PROFIT_SIZE_PCT=0.50

# Exit if price falls MOMENTUM_EXIT_DROP_PCT off its peak within the last
# MOMENTUM_EXIT_LOOKBACK_SAMPLES monitor ticks — catches a sharp reversal
# faster than the trailing stop's configured distance would.
MOMENTUM_EXIT_ENABLED=true
MOMENTUM_EXIT_LOOKBACK_SAMPLES=6
MOMENTUM_EXIT_DROP_PCT=0.12

# Exit on two consecutive lower highs after the position's peak, once at
# least TREND_REVERSAL_MIN_SAMPLES price samples have been observed.
TREND_REVERSAL_EXIT_ENABLED=true
TREND_REVERSAL_MIN_SAMPLES=5

# Off by default — most memecoin setups either work quickly or should be cut
# by the other rules above; a stale winner isn't automatically a bad trade.
# Turn on to force an exit after MAX_POSITION_AGE_HOURS regardless of price.
TIME_BASED_EXIT_ENABLED=false
MAX_POSITION_AGE_HOURS=48

# Reference portfolio size in USD. In paper mode this is your simulated
# starting cash. In live mode this should match the USD value of the capital
# you actually funded the trading wallet/exchange account with — the bot
# tracks P&L against this figure via an internal ledger, it does not poll
# your wallet/exchange for a live balance.
PORTFOLIO_STARTING_BALANCE_USD=1000

# =============================================================================
# AUTOMATIC TOKEN SCANNER — finds newly listed tokens by itself instead of
# waiting for a TradingView alert to name one. Discovered tokens go through
# the SAME pipeline a webhook alert does (risk gate -> signal score -> rug
# check -> sizing), so nothing here bypasses an existing protection.
# =============================================================================

SCANNER_ENABLED=true
SCANNER_INTERVAL_SECONDS=60

# Auto-discovery + auto-buy + real money is a much bigger step than any one
# of those alone: the scanner will find tokens nobody has ever looked at and
# open positions in them unattended. In paper mode that is the whole point.
# With LIVE_TRADING=true the scanner REFUSES to run unless this is also
# true, so upgrading a live deployment can't silently start auto-buying
# brand-new memecoins.
SCANNER_ALLOW_LIVE_TRADING=false

# Free pre-screen, applied to the listing data before any rug check or
# candle fetch is spent on a candidate. Tune these against real output from
# `python scripts/scan_once.py` — too strict and nothing ever trades, too
# loose and you burn API calls on junk.
SCANNER_MAX_TOKENS_PER_CYCLE=30
SCANNER_MIN_LIQUIDITY_USD=35000
SCANNER_MIN_VOLUME_24H_USD=50000
SCANNER_MIN_TXNS_24H=100
SCANNER_MAX_SELL_SHARE=0.70

# Skip a pool's first hours (highest-risk rug window, and too little history
# for the signal engine to read). MAX=0 disables the upper bound.
# MUST be >= SIGNAL_SCORE_MIN_CANDLES x SIGNAL_SCORE_TIMEFRAME (60 x 15m =
# 15h) or the two gates contradict: younger tokens clear the pre-screen and
# are then guaranteed to fail the score gate for lack of history. The bot
# warns loudly at startup if these drift out of sync.
SCANNER_MIN_TOKEN_AGE_HOURS=16
SCANNER_MAX_TOKEN_AGE_HOURS=720

# How long before a rejected token is worth looking at again. Without this
# the scanner re-analyses the same few hundred tokens every single cycle.
SCANNER_RECHECK_MINUTES=60

# Optional. DexScreener discovery always works with no key; a Birdeye key
# adds their dedicated new-listing feed (including launchpad/meme-platform
# tokens) on top. Leave blank to run on DexScreener alone.
BIRDEYE_API_KEY=
BIRDEYE_API_BASE=https://public-api.birdeye.so

# =============================================================================
# LIVE SIGNAL SCORE — the 0-100 composite score (app/signals/scoring.py)
# wired into live entry decisions via live OHLCV from GeckoTerminal
# (app/data/live_provider.py). Fail-closed: no trustworthy live candle data
# means the trade is REJECTED, not admitted on a default score.
# =============================================================================

# Master switch. false skips this gate entirely (loud warning logged) -
# entries then run on the TradingView alert + rug check alone, same as
# before this existed.
LIVE_SIGNAL_SCORE_ENABLED=true
# MEASURED, not guessed. The score is a weighted average of 14 factors so
# it regresses toward 50 by construction — its practical ceiling is nowhere
# near 100. Across 200 runs spanning every market regime:
#   threshold 60 -> ~53% of setups qualify (89% of them genuinely trending)
#   threshold 65 -> ~40% qualify (89% trending)   <-- default
#   threshold 70 -> ~21% qualify (93% trending)
#   threshold 75 -> ~ 8% qualify (100% trending)
# This shipped at 75, which combined with the rug check meant the bot traded
# essentially NEVER. Raise it toward 70 if paper trading shows too many
# marginal entries; lower it toward 60 for more activity.
MIN_SIGNAL_SCORE_TO_ENTER=65
SIGNAL_SCORE_TIMEFRAME=15m
SIGNAL_SCORE_CANDLE_LIMIT=300
SIGNAL_SCORE_MIN_CANDLES=60
GECKOTERMINAL_API_BASE=https://api.geckoterminal.com/api/v2

# =============================================================================
# MARKET-QUALITY GATE (0-100) — "can I actually trade this?"
# =============================================================================
# The THIRD score, and deliberately separate from the other two:
#
#   security score   (REJECT_RUG_SCORE_ABOVE below)  "will this rug?"
#   signal score     (MIN_SIGNAL_SCORE_TO_ENTER)     "is this a good setup?"
#   market quality   (here)                          "can I actually trade it?"
#
# A token can be safe AND print a textbook breakout while being untradeable:
# one wash-traded volume burst, a pool too thin to exit, 90% of the day's
# activity in three prints. The signal engine reads price/volume shape and
# has no way to tell. This does — HIGH VOLUME IS NOT HIGH QUALITY, and two
# of its eight factors exist specifically to score fake volume WORSE than a
# smaller, steadier figure.
#
# Fail-closed, like every other gate: too much missing data marks the score
# unreliable and the trade is rejected, never admitted on a default 50.

MARKET_QUALITY_ENABLED=true
# 50 = the midpoint. A healthy, liquid, two-sided market scores 90+; a thin
# pool or a volume spike drops well below 50 on its own. Raise toward 60 if
# paper trading shows entries into markets you couldn't exit; lowering it
# below ~40 defeats the point of the gate.
MIN_MARKET_QUALITY_SCORE=50

# --- stale-data rejection (app/data/staleness.py) ---
# Stale data is more dangerous than missing data because it looks
# authoritative: a twenty-minute-old memecoin price sails through every
# check and then sizes a position and sets a stop against a market that has
# since become a different asset.
# This is OBSERVATION age (how long ago the bot fetched it), not how long
# ago the market last moved — a quiet pool is a market-quality problem,
# scored above, not a broken feed.
MAX_MARKET_DATA_AGE_SECONDS=120
# A move beyond this factor versus the previous observation is treated as a
# bad tick (decimals bug, thin-pool print, feed glitch) rather than a real
# move. Memecoins genuinely 5x, so this is deliberately generous — it
# catches broken data, not volatility. Setting it too tight makes the bot
# exit winners on a "bad tick" it invented.
MAX_PRICE_JUMP_FACTOR=20

# =============================================================================
# SCORE CALIBRATION RESEARCH — does a higher score actually predict better?
# =============================================================================
# The bot follows the price of every SCORED candidate, traded or rejected,
# and records what it did after 15m / 30m / 1h / 2h / 4h / 8h / 24h. Grouping
# those outcomes by score bucket is the only way to answer whether the
# scoring engine separates good setups from bad ones.
#
# It has to include REJECTED candidates. The bot only trades what it already
# scored highly, so judging the score from trades alone asks "did the setups
# we liked do well?" - a question a completely random score would also pass.
# Following the rejects is what lets the 55s disagree.
#
# Cost: one price lookup per distinct mint per resolution pass. Turning this
# off makes the bot permanently unable to validate or falsify its own scoring.
FORWARD_RETURNS_ENABLED=true
FORWARD_RETURN_RESOLVE_INTERVAL_SECONDS=300
FORWARD_RETURN_BATCH_LIMIT=200

# =============================================================================
# GLOBAL ENTRY KILL SWITCH — stops NEW positions when state is untrustworthy
# =============================================================================
# Not the per-trade risk check. This asks whether the machinery underneath
# that check can be trusted at all right now. It exists for the two failure
# modes that never announce themselves:
#
#   the bot keeps trading on data that stopped updating an hour ago
#   the bot keeps sizing positions off a cash balance that is wrong
#
# Both look normal in the logs, both keep producing trades, and both produce
# a record nobody can interpret afterwards.
#
# It NEVER closes existing positions. Halting entries is safe; liquidating a
# book because a price feed hiccuped turns a data problem into a real loss.
KILL_SWITCH_ENABLED=true
# A critical source silent this long is down, not slow.
KILL_SWITCH_MAX_DATA_AGE_SECONDS=900
KILL_SWITCH_MAX_CONSECUTIVE_FAILURES=5
# Position size is a fraction of portfolio value, which includes open
# positions. Past this share of the book being valued at cost rather than at
# a live price, that fraction means nothing.
KILL_SWITCH_MAX_STALE_VALUATION_SHARE=0.50

# =============================================================================
# EARLY SIGNAL ENGINE — detecting demand arriving, not demand that arrived
# =============================================================================
# A FOURTH score, separate from the other three on purpose:
#
#   security score   "will this rug?"
#   market quality   "can I actually trade it?"
#   technical score  "is this a good setup right now?"
#   early score      "is demand ARRIVING?"
#
# The technical score reads the state of the chart. This reads the
# derivative — is volume accelerating, is transaction rate rising, is buy
# pressure building, is the range coiling. A token can score badly on the
# technical engine precisely BECAUSE the move has not happened yet, which is
# the exact situation this exists to find.
EARLY_SIGNAL_ENABLED=true

# Below this, not interesting enough to keep watching.
EARLY_SIGNAL_WATCH_THRESHOLD=55
# At or above this, plus a healthy pattern and an enterable stage, the
# candidate is CONFIRMED.
EARLY_SIGNAL_CONFIRM_THRESHOLD=70

# Require the existing technical score to agree before entering. This is
# combination strategy "C" — early signal finds the candidate, the existing
# strategy confirms the entry. Set false to test the early engine alone.
EARLY_SIGNAL_REQUIRE_TECHNICAL=true

# How far below MIN_SIGNAL_SCORE_TO_ENTER a technical score may sit and still
# be shown to the early engine. The engine's purpose is to watch charts that
# do not look good YET, so it has to see rejected candidates - but every one
# it sees costs a security lookup and a candle fetch, so the window is
# bounded. With MIN_SIGNAL_SCORE_TO_ENTER=65 this lets 40+ through.
EARLY_SIGNAL_TECHNICAL_MARGIN=25

# ----------------------------------------------------------------------------
# THE SWITCH THAT MATTERS
# ----------------------------------------------------------------------------
# false = the early engine can raise a token to WATCH and can NEVER open a
# position by itself. The existing technical strategy stays the only thing
# that trades.
#
# The early-score weights are UNVALIDATED PRIORS: chosen by reasoning about
# market microstructure, not measured against outcomes, because no outcome
# data exists yet. Turning this on before /research shows a monotonic
# calibration curve means trading on a guess.
#
# Leave it false until the evidence says otherwise.
EARLY_SIGNAL_MAY_TRADE=false

# WATCH tokens are re-scored on this interval. Score history is kept, so it
# is possible to ask later whether an IMPROVING score beats a high static one.
WATCHLIST_INTERVAL_SECONDS=120
WATCHLIST_MAX_AGE_HOURS=12
WATCHLIST_MAX_SIZE=200

# Stored snapshots feed the flow features (transaction rate, buy-pressure
# change) which have no other source — DexScreener reports transaction counts
# only over 1h/24h windows, so "is the rate rising?" is only answerable by
# differencing observations the bot kept itself.
OBSERVATION_RETENTION_HOURS=48

# =============================================================================
# RUG-PULL / SCAM FILTER — runs before every buy, blocks the trade on failure
# =============================================================================

RUGCHECK_ENABLED=true
MAX_TOP10_HOLDER_PCT=0.35
MIN_LIQUIDITY_USD=15000
MAX_PRICE_IMPACT_PCT=0.05
DEV_WALLET_SELL_ALERT_PCT=0.10

# Composite Rug Risk Score (0-100, app/rugcheck/risk_score.py) threshold —
# an ADDITIONAL gate on top of the binary checks above, not a replacement.
# A token can fail this even after passing every one of them, if enough
# moderate risk factors (thin liquidity, a brand-new pool, heavy sell
# pressure, a large dev wallet, ...) stack up together.
REJECT_RUG_SCORE_ABOVE=65

# Optional but recommended — higher rate limits than the anonymous tier.
GOPLUS_API_KEY=
GOPLUS_API_BASE=https://api.gopluslabs.io/api/v1
HONEYPOT_API_BASE=https://api.honeypot.is/v2
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1

# Reject when the Solana specialist reports any risk it classes as "danger".
# Setting this false downgrades those to warnings, which is NOT recommended:
# "large amount of LP unlocked" arrives as exactly such a risk.
REJECT_ON_DANGER_RISKS=true

# =============================================================================
# MONITORING LOOP
# =============================================================================

PRICE_POLL_INTERVAL_SECONDS=30
DEV_WALLET_POLL_INTERVAL_SECONDS=300
DAILY_SUMMARY_HOUR_UTC=23

# =============================================================================
# NOTIFICATIONS
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# DASHBOARD (HTTP Basic Auth)
# =============================================================================

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
