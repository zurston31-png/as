# SignalIQ environment configuration - EXAMPLE FILE WITH PLACEHOLDERS ONLY.
#
#   1. Copy this file:   cp .env.example .env      (Windows: copy .env.example .env)
#   2. Replace the two placeholder values below with your own Alpaca API keys.
#   3. Never commit the real .env file (it is listed in .gitignore).

# --- Alpaca Market Data API credentials (required for downloading bars) ------
# Create them at https://app.alpaca.markets (paper-trading keys work for data).
APCA_API_KEY_ID=REPLACE_WITH_YOUR_ALPACA_KEY_ID
APCA_API_SECRET_KEY=REPLACE_WITH_YOUR_ALPACA_SECRET_KEY

# Only for managed runtimes whose network proxy adds the secret key to requests
# for data.alpaca.markets (for example a Claude Code cloud environment with the
# secret saved as a network secret). Leave APCA_API_SECRET_KEY unset there and
# switch this on; the secret then never enters the application at all.
# SIGNALIQ_ALPACA_SECRET_FROM_PROXY=true

# --- Optional settings (defaults shown; uncomment to change) -----------------
# SQLite database location. Relative paths are resolved from the project folder.
# SIGNALIQ_DATABASE_URL=sqlite:///data/signaliq.db

# Market data feed. SignalIQ always requests exactly this feed and never
# substitutes another one. The free Alpaca plan provides "iex".
# SIGNALIQ_ALPACA_FEED=iex

# Corporate-action adjustment applied by the provider.
# SIGNALIQ_ALPACA_ADJUSTMENT=split

# First date to request (actual history depends on what the provider has).
# SIGNALIQ_HISTORY_START=2016-01-01

# Comma-separated symbol universe (default: the ten Milestone 1 symbols).
# SIGNALIQ_SYMBOLS=AAPL,MSFT,NVDA,AMD,AMZN,META,TSLA,GOOGL,SPY,QQQ

# HTTP behaviour.
# SIGNALIQ_HTTP_TIMEOUT_SECONDS=30
# SIGNALIQ_HTTP_MAX_RETRIES=5

# Logging level: DEBUG, INFO, WARNING, ERROR.
# SIGNALIQ_LOG_LEVEL=INFO
