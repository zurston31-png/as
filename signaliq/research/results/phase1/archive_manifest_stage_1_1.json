{
 "format": "signaliq-research-archive/1",
 "source": "universe_stage.db",
 "schema": [
  "CREATE TABLE batch_symbols (\n\tsymbol VARCHAR(16) NOT NULL, \n\tcategory VARCHAR(32) NOT NULL, \n\tselection VARCHAR(64) NOT NULL, \n\treason TEXT NOT NULL, \n\tdeclared_type VARCHAR(16) NOT NULL, \n\tdiscovered_from VARCHAR(16), \n\tPRIMARY KEY (symbol)\n)",
  "CREATE TABLE candidates (\n\tsymbol VARCHAR(16) NOT NULL, \n\tsources VARCHAR(160) NOT NULL, \n\tmonths_with_trades INTEGER NOT NULL, \n\tbest_rank INTEGER, \n\tbest_month DATE, \n\tselection VARCHAR(16) NOT NULL, \n\treason TEXT NOT NULL, \n\tPRIMARY KEY (symbol)\n)",
  "CREATE TABLE corporate_actions (\n\tid VARCHAR(64) NOT NULL, \n\taction_type VARCHAR(32) NOT NULL, \n\tprocess_date DATE, \n\tex_date DATE, \n\teffective_date DATE, \n\tsymbol VARCHAR(32), \n\told_symbol VARCHAR(32), \n\tnew_symbol VARCHAR(32), \n\tacquiree_symbol VARCHAR(32), \n\tacquirer_symbol VARCHAR(32), \n\told_rate FLOAT, \n\tnew_rate FLOAT, \n\trate FLOAT, \n\tcash_rate FLOAT, \n\traw JSON NOT NULL, \n\tfetched_at VARCHAR(27) NOT NULL, \n\tPRIMARY KEY (id)\n)",
  "CREATE TABLE deal_values (\n\tsecurity_id INTEGER NOT NULL, \n\tacquirer_symbol VARCHAR(16) NOT NULL, \n\teffective_date DATE NOT NULL, \n\tcash_per_share FLOAT NOT NULL, \n\tshares_per_share FLOAT NOT NULL, \n\tacquirer_session DATE, \n\tacquirer_close FLOAT, \n\tvalue FLOAT, \n\ttarget_last_close FLOAT, \n\tstatus VARCHAR(32) NOT NULL, \n\tsource_url TEXT NOT NULL, \n\tnote TEXT NOT NULL, \n\tPRIMARY KEY (security_id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE exit_evidence (\n\tid INTEGER NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tsource VARCHAR(32) NOT NULL, \n\tcategory VARCHAR(32) NOT NULL, \n\tevent_date DATE, \n\tdetail TEXT NOT NULL, \n\treference VARCHAR(128), \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE external_responses (\n\tsource VARCHAR(32) NOT NULL, \n\trequest_key VARCHAR(128) NOT NULL, \n\tresponse JSON NOT NULL, \n\tfetched_at VARCHAR(27) NOT NULL, \n\tPRIMARY KEY (source, request_key)\n)",
  "CREATE TABLE issuer_evidence (\n\tid INTEGER NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tsymbol VARCHAR(16) NOT NULL, \n\tfiled DATE NOT NULL, \n\tcik VARCHAR(10) NOT NULL, \n\tname VARCHAR(160) NOT NULL, \n\thow VARCHAR(32) NOT NULL, \n\turl VARCHAR(300) NOT NULL, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE issuer_sic (\n\tid INTEGER NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tcik VARCHAR(10) NOT NULL, \n\tas_of DATE NOT NULL, \n\tsic VARCHAR(4), \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE membership (\n\tdecision_session DATE NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\trule_fingerprint VARCHAR(64) NOT NULL, \n\teligible INTEGER NOT NULL, \n\treason VARCHAR(48), \n\traw_close FLOAT, \n\tmedian_dollar_volume FLOAT, \n\trank INTEGER, \n\tmember INTEGER NOT NULL, \n\tPRIMARY KEY (decision_session, security_id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE monthly_bars (\n\tsymbol VARCHAR(16) NOT NULL, \n\tmonth DATE NOT NULL, \n\thigh FLOAT NOT NULL, \n\tclose FLOAT NOT NULL, \n\tvolume BIGINT NOT NULL, \n\tvwap FLOAT NOT NULL, \n\ttrade_count BIGINT NOT NULL, \n\tPRIMARY KEY (symbol, month)\n)",
  "CREATE TABLE securities (\n\tsecurity_id INTEGER NOT NULL, \n\tfirst_session DATE NOT NULL, \n\tlast_trade_session DATE NOT NULL, \n\tlast_symbol VARCHAR(16) NOT NULL, \n\tstatus VARCHAR(16) NOT NULL, \n\texit_type VARCHAR(32) NOT NULL, \n\texit_event_id VARCHAR(64), \n\texit_cash_rate FLOAT, \n\tacquirer_symbol VARCHAR(16), \n\tassumed_exit_value FLOAT, \n\texit_assumption TEXT, \n\tdeclared_type VARCHAR(16) NOT NULL, \n\treal_trade_sessions INTEGER NOT NULL, security_type VARCHAR(16) DEFAULT 'unknown' NOT NULL, type_status VARCHAR(16) DEFAULT 'unknown' NOT NULL, outcome VARCHAR(32), outcome_status VARCHAR(16), value_basis VARCHAR(16), \n\tPRIMARY KEY (security_id)\n)",
  "CREATE TABLE security_bars (\n\tsecurity_id INTEGER NOT NULL, \n\tsession DATE NOT NULL, \n\tsymbol VARCHAR(16) NOT NULL, \n\topen FLOAT NOT NULL, \n\thigh FLOAT NOT NULL, \n\tlow FLOAT NOT NULL, \n\tclose FLOAT NOT NULL, \n\tvolume BIGINT NOT NULL, \n\tvwap FLOAT NOT NULL, \n\ttrade_count BIGINT NOT NULL, \n\tsplit_factor FLOAT NOT NULL, \n\talpaca_adjusted_close FLOAT, distribution_factor FLOAT DEFAULT '1.0' NOT NULL, \n\tPRIMARY KEY (security_id, session), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE security_issuers (\n\tsecurity_id INTEGER NOT NULL, \n\tcik VARCHAR(10) NOT NULL, \n\tname VARCHAR(160) NOT NULL, \n\thow VARCHAR(32) NOT NULL, \n\tPRIMARY KEY (security_id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE security_registry (\n\tsecurity_key VARCHAR(48) NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tfirst_symbol VARCHAR(16) NOT NULL, \n\tfirst_session DATE NOT NULL, \n\tstatus VARCHAR(16) NOT NULL, \n\tmerged_into INTEGER, \n\tPRIMARY KEY (security_key), \n\tUNIQUE (security_id)\n)",
  "CREATE TABLE segment_links (\n\tlink_id VARCHAR(64) NOT NULL, \n\tsymbol VARCHAR(16) NOT NULL, \n\tearlier_last DATE NOT NULL, \n\tlater_first DATE NOT NULL, \n\tgap_sessions INTEGER NOT NULL, \n\tclose_before FLOAT, \n\tclose_after FLOAT, \n\tsplit_ratio FLOAT NOT NULL, \n\tissuer_before VARCHAR(10), \n\tissuer_after VARCHAR(10), \n\tdecision VARCHAR(16) NOT NULL, \n\treason TEXT NOT NULL, \n\tPRIMARY KEY (link_id)\n)",
  "CREATE TABLE sip_research_alembic_version (\n\tversion_num VARCHAR(32) NOT NULL, \n\tCONSTRAINT sip_research_alembic_version_pkc PRIMARY KEY (version_num)\n)",
  "CREATE TABLE spin_offs (\n\tid INTEGER NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tsource VARCHAR(32) NOT NULL, \n\treference TEXT NOT NULL, \n\tparent_symbol VARCHAR(16) NOT NULL, \n\tex_date DATE NOT NULL, \n\tchildren JSON NOT NULL, \n\tparent_close_before FLOAT, \n\tparent_close_on FLOAT, \n\tdistribution_value FLOAT, \n\tfactor FLOAT, \n\tholder_return FLOAT, \n\tstatus VARCHAR(24) NOT NULL, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE split_checks (\n\tevent_id VARCHAR(64) NOT NULL, \n\tsecurity_id INTEGER, \n\tsymbol VARCHAR(16) NOT NULL, \n\tex_date DATE NOT NULL, \n\tratio FLOAT NOT NULL, \n\tclose_before FLOAT, \n\tclose_on FLOAT, \n\tverdict VARCHAR(16) NOT NULL, \n\tPRIMARY KEY (event_id)\n)",
  "CREATE TABLE ticker_bars (\n\tsymbol VARCHAR(16) NOT NULL, \n\tsession DATE NOT NULL, \n\topen FLOAT NOT NULL, \n\thigh FLOAT NOT NULL, \n\tlow FLOAT NOT NULL, \n\tclose FLOAT NOT NULL, \n\tvolume BIGINT NOT NULL, \n\tvwap FLOAT NOT NULL, \n\ttrade_count BIGINT NOT NULL, \n\tis_filler INTEGER NOT NULL, \n\tPRIMARY KEY (symbol, session)\n)",
  "CREATE TABLE ticker_history (\n\tsecurity_id INTEGER NOT NULL, \n\tsymbol VARCHAR(16) NOT NULL, \n\tvalid_from DATE NOT NULL, \n\tvalid_to DATE NOT NULL, \n\tlinked_by VARCHAR(64) NOT NULL, \n\tPRIMARY KEY (security_id, symbol, valid_from), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE TABLE type_evidence (\n\tid INTEGER NOT NULL, \n\tsecurity_id INTEGER NOT NULL, \n\tsource VARCHAR(32) NOT NULL, \n\tsymbol VARCHAR(16) NOT NULL, \n\tsecurity_type VARCHAR(16) NOT NULL, \n\tdetail TEXT NOT NULL, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(security_id) REFERENCES securities (security_id)\n)",
  "CREATE INDEX ix_corporate_actions_acquiree_symbol ON corporate_actions (acquiree_symbol)",
  "CREATE INDEX ix_corporate_actions_action_type ON corporate_actions (action_type)",
  "CREATE INDEX ix_corporate_actions_new_symbol ON corporate_actions (new_symbol)",
  "CREATE INDEX ix_corporate_actions_old_symbol ON corporate_actions (old_symbol)",
  "CREATE INDEX ix_corporate_actions_symbol ON corporate_actions (symbol)",
  "CREATE INDEX ix_exit_evidence_security_id ON exit_evidence (security_id)",
  "CREATE INDEX ix_issuer_evidence_security_id ON issuer_evidence (security_id)",
  "CREATE INDEX ix_issuer_sic_security_id ON issuer_sic (security_id)",
  "CREATE INDEX ix_type_evidence_security_id ON type_evidence (security_id)"
 ],
